# Строка подключения к Postgres. Пусто — встроенный PGlite (данные из сида, в памяти):
# локально (NODE_ENV не production) это демо-режим автоматически; в production без DATABASE_URL
# приложение не стартует, если не задан DEMO_MODE=1.
DATABASE_URL=
# 1 — явный демо-режим: сид, кнопки демо-входа, плашка «Демо-версия». Обязателен для превью
# на Vercel (там NODE_ENV=production). В проде ЦРП не задавать.
DEMO_MODE=
# Папка для PGlite, если нужен файл вместо памяти (только демо/разработка).
# Если задан, задайте и STORAGE_DIR рядом: иначе файлы пропадут при перезапуске.
PGLITE_DIR=
# Секрет подписи cookie сессии: 32+ символа (например, `openssl rand -base64 48`).
# Обязателен везде, кроме демо на PGlite; заданный, но короче 32 символов — ошибка и в демо.
SESSION_SECRET=
# IP клиента для лимитов входа/регистрации (BUILD.md §5). Число своих прокси перед приложением:
# N > 0 — берётся N-е значение X-Forwarded-For справа; 0 (по умолчанию) — X-Forwarded-For
# игнорируется. Сервер ЦРП за одним nginx — 1. Неверное значение позволяет подделать IP.
TRUSTED_PROXY_HOPS=
# 1 — доверять X-Real-IP (только при TRUSTED_PROXY_HOPS=0 и если его ставит сама платформа,
# например Vercel). Без доверенного источника IP «неизвестен»: общее ведро на IP + лимит на email.
TRUST_X_REAL_IP=
# 1 — заполнить пустую БД демо-данными и в режиме Postgres.
SEED_DEMO=
# Публичный адрес платформы: ссылки в письмах и QR сертификатов. Вне демо — обязательно https://,
# иначе почтовые функции и PDF сертификата не включатся (D-025). В демо можно не задавать:
# берётся URL (Netlify), затем VERCEL_URL, иначе http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Необязательно: папка миграций (по умолчанию ./migrations), размер пула postgres.js.
MIGRATIONS_DIR=
DB_POOL_MAX=
# Только для тестов: прогнать интеграционные тесты на настоящем Postgres вместо PGlite.
TEST_DATABASE_URL=

# --- Флаги функций (D-025): 1 — включить, 0 — выключить. Пусто: в демо включено, иначе выключено.
# Вне демо функции нужны ещё условия готовности (BUILD.md §13). На сервере ЦРП — 0 до приёмки.
FEATURE_PASSWORD_RESET=
FEATURE_EMAIL_VERIFY=
FEATURE_REMINDERS=
FEATURE_UPLOADS=
FEATURE_LEGAL=
FEATURE_CERT_PDF=

# --- Почта (D-030). outbox — письма только сохраняются и видны в админке «Письма», наружу не уходят.
# Другой транспорт — после решения ЦРП о провайдере (D-009). В демо всегда outbox.
MAIL_TRANSPORT=outbox
# Отправитель и адрес для ответов, например noreply@<домен ЦРП> и рабочий ящик ЦРП.
MAIL_FROM=
MAIL_REPLY_TO=
# Предохранитель: писем сброса пароля и подтверждения email в час на всех. По умолчанию 300.
MAIL_AUTH_HOURLY_CAP=
# Сколько дней хранить письма (очередь и история). По умолчанию 90.
MAIL_RETENTION_DAYS=

# --- Файлы (D-034). Каталог на сервере ЦРП: абсолютный путь вне каталога приложения, входит в бэкап.
# Пусто: в демо — временный каталог, вне демо загрузка недоступна (503).
STORAGE_DIR=
# local (по умолчанию). s3 — после решения ЦРП (хранилище в РК), пока не реализован.
STORAGE_PROVIDER=
# Квоты в байтах: на все файлы и на один курс. По умолчанию 20 ГБ и 2 ГБ.
UPLOAD_QUOTA_BYTES=
UPLOAD_COURSE_QUOTA_BYTES=

# --- БД и выкладка в production (D-026, D-027).
# 1 — накатывать миграции при старте и в production (на сервере ЦРП не задавать). Пусто: в production
# приложение только проверяет миграции и не стартует, если они не накатаны; в демо и разработке накатывает.
DB_MIGRATE_ON_START=
# Сколько ждать блокировку таблицы при миграции, мс (npm run db:migrate). По умолчанию 5000.
MIGRATE_LOCK_TIMEOUT_MS=
# Роли Postgres для npm run db:grants и проверки окружения. На сервере ЦРП — crp_app и crp_owner.
DB_APP_ROLE=
DB_OWNER_ROLE=
# Ключ шифрования server actions, один для всех релизов (openssl rand -base64 32).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# 1 — не отправлять телеметрию Next (она уходит за рубеж). На сервере ЦРП — 1.
NEXT_TELEMETRY_DISABLED=
