# Строка подключения к Postgres. Пусто — демо-режим на встроенном PGlite (данные из сида, в памяти).
DATABASE_URL=
# Папка для PGlite, если нужен файл вместо памяти (только демо/разработка).
PGLITE_DIR=
# Секрет подписи cookie сессии. Обязателен вне демо-режима (32+ случайных байта).
SESSION_SECRET=
# 1 — заполнить пустую БД демо-данными и в режиме Postgres.
SEED_DEMO=
# Публичный адрес платформы (для ссылок в письмах и QR сертификатов).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Необязательно: папка миграций (по умолчанию ./migrations), размер пула postgres.js.
MIGRATIONS_DIR=
DB_POOL_MAX=
# Только для тестов: прогнать интеграционные тесты на настоящем Postgres вместо PGlite.
TEST_DATABASE_URL=
