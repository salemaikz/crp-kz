# /etc/crp/app.env (root:crp, 0640): окружение приложения и крон-скриптов. Роль БД: crp_app.
# Шаблон без секретов: значения в угловых скобках вносит оператор на сервере, в репозиторий
# они не попадают. Формат KEY=VALUE без кавычек и подстановок: файл читают Node (--env-file),
# Next (.env.production) и скрипты эксплуатации без source.
# NODE_ENV сюда не пишем: его задают PM2, run-script.sh и deploy.sh.
# Все ключи должны быть в корневом .env.example (проверяет тест ops-deploy-files).

# --- БД. sslmode=require обязателен (ops-preflight: database_url_no_ssl). Пароль: \password crp_app.
DATABASE_URL=postgres://crp_app:<пароль-crp_app>@127.0.0.1:5432/crp?sslmode=require
DB_POOL_MAX=10
# В production миграции накатывает только выкладка (npm run db:migrate от crp_owner). Пусто или 0.
DB_MIGRATE_ON_START=0
DB_APP_ROLE=crp_app
DB_OWNER_ROLE=crp_owner

# --- Сессии и server actions. Менять SESSION_SECRET нельзя без выхода всех пользователей.
# SESSION_SECRET: openssl rand -base64 48
SESSION_SECRET=<openssl-rand-base64-48>
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY: openssl rand -base64 32, один на все релизы.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=<openssl-rand-base64-32>

# --- Адрес и прокси. Вшивается при сборке. За одним nginx: TRUSTED_PROXY_HOPS=1, X-Real-IP не доверяем.
NEXT_PUBLIC_SITE_URL=https://<домен>
TRUSTED_PROXY_HOPS=1
TRUST_X_REAL_IP=

# --- Демо-режим на проде запрещён: preflight останавливает выкладку, если что-то из этого задано.
DEMO_MODE=
SEED_DEMO=
PGLITE_DIR=

# --- Телеметрия Next уходит за рубеж.
NEXT_TELEMETRY_DISABLED=1

# --- Флаги функций (D-025): 0, пока функция не прошла приёмку. Включает владелец функции.
FEATURE_PASSWORD_RESET=0
FEATURE_EMAIL_VERIFY=0
FEATURE_REMINDERS=0
FEATURE_UPLOADS=0
FEATURE_LEGAL=0
FEATURE_CERT_PDF=0

# --- Почта (D-030). outbox: письма только сохраняются и видны в админке, наружу не уходят.
MAIL_TRANSPORT=outbox
MAIL_FROM=
MAIL_REPLY_TO=

# --- Файлы (D-034). Абсолютный путь вне каталога приложения; входит в бэкап (D-029, предложено).
STORAGE_DIR=/var/lib/crp/files
