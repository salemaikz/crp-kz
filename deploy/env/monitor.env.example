# /etc/crp/monitor.env (root:crp, 0640): настройки healthcheck.sh.
# Домен нужен для проверки сертификата и внешней проверки https://<домен>/api/health.
DOMAIN=<домен>
# Канал алертов выбирает владелец. Пусто: алерты идут в journald (logger -t crp-alert) и в журнал
# /var/log/crp/healthcheck.log. Telegram за рубежом: сообщения без ПДн, но сервис зарубежный (D-009).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
