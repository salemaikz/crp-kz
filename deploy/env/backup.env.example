# /etc/crp/backup.env (root:root, 0644): настройки backup.sh и restore.sh. Секретов здесь нет:
# файл читают и postgres (бэкап БД), и crp (бэкап файлов). Ключи age и пароли сюда не писать.
#
# D-029 ПРЕДЛОЖЕНО, ждёт владельца. Три решения, без которых бэкап неполный:
#   1. Где вторая копия в РК (BACKUP_REMOTE). Пока пусто: копия только на этом сервере,
#      и при потере сервера данные теряются вместе с бэкапом (healthcheck при заданном BACKUP_REMOTE и offsite=false даёт предупреждение).
#   2. Кто хранит приватные ключи age (BACKUP_AGE_RECIPIENTS_FILE хранит только открытые ключи).
#   3. Приемлем ли RPO 24 часа (бэкап раз в сутки).
# Копия за пределами РК запрещена (D-009): трансграничная передача только по решению ЦРП и юриста.

BACKUP_DB=crp
BACKUP_OWNER_ROLE=crp_owner
BACKUP_APP_ROLE=crp_app
BACKUP_DIR=/var/backups/crp
# Файл с открытыми ключами age двух хранителей, по одному в строке (deploy/env/backup-recipients.example).
BACKUP_AGE_RECIPIENTS_FILE=/etc/crp/backup-recipients.txt
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=6

# Вторая копия: назначение rsync по SSH в хранилище в РК у другого провайдера.
# Формат: <пользователь>@<хост-хранилища-в-РК>:<каталог>. Пусто до решения владельца.
BACKUP_REMOTE=
# Путь к приватному SSH-ключу для rsync бэкапа БД; читает только postgres (файл 0600, владелец postgres).
# Основная защита на стороне хранилища: снапшоты или неизменяемое хранилище. Вторая линия: authorized_keys
# с command="rrsync -wo -no-del -no-overwrite <каталог>",restrict (голый -wo удаление не запрещает).
# Пусто, если ключ не нужен.
BACKUP_REMOTE_SSH_KEY=

# Вторая копия файлов (backup.sh --files) уходит от пользователя crp, то есть от пользователя приложения:
# его ключ достанется тому, кто взломает приложение. Поэтому для файлов заводится свой ключ (владелец crp,
# 0600) и свой каталог в хранилище с тем же rrsync -wo -no-del -no-overwrite. Ключ БД crp не читает.
# Пустые значения: для файлов берутся BACKUP_REMOTE и BACKUP_REMOTE_SSH_KEY (общий ключ для crp
# недоступен, так что без своего ключа копия файлов не уйдёт).
# Пример: BACKUP_FILES_REMOTE=<пользователь>@<хост-хранилища-в-РК>:<каталог-для-файлов>
BACKUP_FILES_REMOTE=
# Пример: BACKUP_FILES_REMOTE_SSH_KEY=/var/lib/crp/.ssh/<имя-ключа-для-файлов>
BACKUP_FILES_REMOTE_SSH_KEY=

# Каталог загруженных файлов; пустой или незаданный — бэкап файлов ничего не делает.
STORAGE_DIR=/var/lib/crp/files
