# /etc/crp/migrate.env (root:crpdeploy, 0640): только для deploy.sh (миграции и права).
# Роль crp_owner владеет схемой и может менять её; процесс приложения этого файла не читает.
# Значения в угловых скобках вносит оператор на сервере.
DATABASE_URL=postgres://crp_owner:<пароль-crp_owner>@127.0.0.1:5432/crp?sslmode=require
# Сколько ждать блокировку таблицы при миграции, мс.
MIGRATE_LOCK_TIMEOUT_MS=5000
DB_APP_ROLE=crp_app
DB_OWNER_ROLE=crp_owner
